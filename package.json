{
  "name": "whyme-apps",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:mobile": "turbo run dev --filter=mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "api:generate": "pnpm --filter @whyme/api-client generate",
    "i18n:check": "node scripts/check-i18n.mjs",
    "tokens:build": "pnpm --filter @whyme/tokens build"
  },
  "devDependencies": {
    "turbo": "^2",
    "typescript": "^5",
    "@types/node": "^24"
  }
}
