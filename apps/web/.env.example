# Laravel API base URL (whyme-api), without the version: requests go to /v1/….
# Locally: `php artisan serve` on port 8000.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# The API as the Next.js server reaches it (server-rendered pages). Defaults to
# NEXT_PUBLIC_API_URL; set it when the server can use a private address.
API_INTERNAL_URL=

# This website's public address, for canonical links and link previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
