# Laravel API base URL, without the version (requests go to /v1/…).
# Android emulator reaches your PC's localhost at 10.0.2.2; on a real phone use
# your PC's LAN IP (e.g. http://192.168.1.20:8000/api) in .env.local, and run the API with
# --host=0.0.0.0 (launch config "api-lan"). Leave it unset for the browser web preview
# (http://localhost:8081), which then uses http://localhost:8000/api.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api
